import java.util.*;
class FeedbackWordFrequency 
{
private static final String[] STOP_WORDS = {"the", "was", "and", "a", "is", "of", "in"};
void printFilteredWordFrequency(String feedback) 
{
String cleaned = feedback.toLowerCase().replace(".", "").replace(",", "");
String[] words = cleaned.split("\\s+");
String[] uniqueWords = new String[words.length];
int[] counts = new int[words.length];
int uniqueCount = 0;
for (String word : words) 
{
if (word.isEmpty() || isStopWord(word)) 
continue;
int foundIndex = -1;
for (int i = 0; i < uniqueCount; i++) 
{
if (uniqueWords[i].equals(word)) 
{
foundIndex = i;
break;
}
}
if (foundIndex == -1) 
{
uniqueWords[uniqueCount] = word;
counts[uniqueCount] = 1;
uniqueCount++;
} 
else 
{
counts[foundIndex]++;
}
}
for (int i = 0; i < uniqueCount - 1; i++) 
{
for (int j = 0; j < uniqueCount - 1 - i; j++) 
{
if (counts[j] < counts[j + 1]) 
{
int tempCount = counts[j];
counts[j] = counts[j + 1];
counts[j + 1] = tempCount;
String tempWord = uniqueWords[j];
uniqueWords[j] = uniqueWords[j + 1];
uniqueWords[j + 1] = tempWord;
}
}
}
for (int i = 0; i < uniqueCount; i++) 
{
System.out.println(uniqueWords[i] + ": " + counts[i]);
}
}
private boolean isStopWord(String word) 
{
for (String stopWord : STOP_WORDS) 
{
if (stopWord.equals(word)) 
{
return true;
}
}
return false;
}
public static void main(String[] args) 
{
FeedbackWordFrequency fw = new FeedbackWordFrequency();
fw.printFilteredWordFrequency("The mentor was great, the session was great and clear.");
}
}
