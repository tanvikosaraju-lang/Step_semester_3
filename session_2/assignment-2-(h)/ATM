class ATM
{
void atmPinRetry(String correctPin, String[] attempts)
{
int count = 0;
boolean isTrue = false;
while (count<attempts.length && count<3 && !isTrue)
{
String attempt = attempts[count];
if (attempt.equals(correctPin))
{
isTrue = true;
System.out.println("PIN accepted\n");
break;
}
count++;
}
if (!isTrue)
{
System.out.println("Card blocked — too many incorrect attempts\n");
}
}
public static void main(String[] args)
{
ATM a = new ATM();
String correctPin1 = "4821";
String[] attempts1 = {"1111", "4821"};
a.atmPinRetry(correctPin1, attempts1);
String correctPin2 = "4821";
String[] attempts2 = {"1111", "2222", "3333"};
a.atmPinRetry(correctPin2, attempts2);
}
}
