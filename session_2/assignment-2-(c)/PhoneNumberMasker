class PhoneNumberMasker 
{
String maskPhoneNumber(String phone) 
{
if (phone.length() != 10 || !isAllDigits(phone)) 
{
return "Invalid phone number";
}
String lastFourDigits = phone.substring(phone.length() - 4);
StringBuilder sb = new StringBuilder("XXXXXX");
sb.insert(6, "-");
sb.insert(7, lastFourDigits);
return sb.toString();
}
private boolean isAllDigits(String str) 
{
for (int i = 0; i < str.length(); i++) 
{
if (!Character.isDigit(str.charAt(i))) 
{
return false;
}
}
return true;
}
public static void main(String[] args) 
{
PhoneNumberMasker nm = new PhoneNumberMasker();
System.out.println(nm.maskPhoneNumber("9876543210"));
System.out.println(nm.maskPhoneNumber("98765"));
}
}
