class FileExtensionValidator
{
String validateFileExtension(String filename) 
{
int dotIndex = filename.lastIndexOf('.');
if (dotIndex == -1 || dotIndex == filename.length() - 1) {
return "Invalid File Type!";
}
String extension = filename.substring(dotIndex + 1);
if (extension.equalsIgnoreCase("pdf")|| extension.equalsIgnoreCase("docx")|| extension.equalsIgnoreCase("zip")) 
{
return "Accepted";
} 
else 
{
return "Invalid File Type!";
}
}
public static void main(String[] args) 
{
FileExtensionValidator f = new FileExtensionValidator();
System.out.println(f.validateFileExtension("Assignment1.PDF"));
System.out.println(f.validateFileExtension("notes.txt"));
}
}
