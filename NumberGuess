class NumberGuess
{
void guessTheNumber(int secretNumber, int maxTries, int[] guesses) 
{
int tries = 0;
boolean isTrue = false;
while (tries<maxTries && tries<guesses.length && !isTrue) 
{
int currentGuess = guesses[tries];
if (currentGuess > secretNumber) 
{
System.out.println("Too high\n");
} 
else if (currentGuess < secretNumber)
{
System.out.println("Too low\n");
} 
else 
{
System.out.println("Correct! You guessed it\n");
isTrue = true;
break;
}
tries++;
}
if (!isTrue) 
{
System.out.println("Out of tries — the number was " + secretNumber);
}
}
public static void main(String[] args) 
{
NumberGuess ng = new NumberGuess();
System.out.println("Test 1\n");
int[] guesses1 = {12, 45, 30, 25};
ng.guessTheNumber(25, 5, guesses1);
System.out.println("Test 2\n");
int[] guesses2 = {10, 20, 30};
ng.guessTheNumber(42, 3, guesses2);
}
}
