class FindMinRotatedArray 
{
int findMin(int[] nums) 
{
int left = 0;
int right = nums.length - 1;
while (left < right) 
{
int mid = left + (right - left) / 2;
if (nums[mid] > nums[right]) 
{
left = mid + 1;
} 
else 
{
right = mid;
}
}
return nums[left];
}
public static void main(String[] args) 
{
FindMinRotatedArray solver = new FindMinRotatedArray();
int result1 = solver.findMin(new int[]{3, 4, 5, 1, 2});
System.out.println(result1);
int result2 = solver.findMin(new int[]{4, 5, 6, 7, 0, 1, 2});
System.out.println(result2);
int result3 = solver.findMin(new int[]{11, 13, 15, 17});
System.out.println(result3);
}
}
