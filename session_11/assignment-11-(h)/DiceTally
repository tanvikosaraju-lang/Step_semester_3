import java.util.Arrays;

public class DiceTally {
    public static void lineUp(int[] heights) {
        int n = heights.length;
        boolean swapped;
        int pass = 1;

        for (int i = 0; i < n - 1; i++) {
            swapped = false;
            for (int j = 0; j < n - 1 - i; j++) {
                if (heights[j] > heights[j + 1]) {
                    int temp = heights[j];
                    heights[j] = heights[j + 1];
                    heights[j + 1] = temp;
                    swapped = true;
                }
            }
            System.out.println("Pass " + pass + ": " + Arrays.toString(heights));
            if (!swapped) {
                break;
            }
            pass++;
        }
    }

    public static int prizeTable(int[] marks) {
        int n = marks.length;
        int swapCount = 0;

        for (int i = 0; i < n - 1; i++) {
            int maxIndex = i;
            for (int j = i + 1; j < n; j++) {
                if (marks[j] > marks[maxIndex]) {
                    maxIndex = j;
                }
            }
            if (maxIndex != i) {
                int temp = marks[i];
                marks[i] = marks[maxIndex];
                marks[maxIndex] = temp;
                swapCount++;
            }
        }
        return swapCount;
    }

    public static void shelf(int[] books) {
        for (int i = 1; i < books.length; i++) {
            int key = books[i];
            int j = i - 1;

            while (j >= 0 && books[j] > key) {
                books[j + 1] = books[j];
                j--;
            }
            books[j + 1] = key;
            System.out.println("After placing " + key + ": " + Arrays.toString(books));
        }
    }

    public static int firstBreak(int[] tokens) {
        for (int i = 1; i < tokens.length; i++) {
            if (tokens[i] < tokens[i - 1]) {
                return i;
            }
        }
        return -1;
    }

    public static int[] diceSort(int[] rolls) {
        int[] count = new int[7];
        for (int roll : rolls) {
            count[roll]++;
        }

        System.out.print("Counts: ");
        for (int i = 1; i <= 6; i++) {
            System.out.print(i + ":" + count[i] + (i < 6 ? " " : ""));
        }
        System.out.println();

        int[] sorted = new int[rolls.length];
        int idx = 0;
        for (int i = 1; i <= 6; i++) {
            for (int j = 0; j < count[i]; j++) {
                sorted[idx++] = i;
            }
        }
        return sorted;
    }

    public static void main(String[] args) {
        int[] heights1 = {4, 2, 5, 1};
        int[] heights2 = {1, 3, 2, 4};

        System.out.println("Problem 1: The Height Line-Up");
        lineUp(heights1);
        lineUp(heights2);

        System.out.println("\nProblem 2: The Prize Table");
        int[] marks1 = {45, 90, 60, 75};
        int swaps1 = prizeTable(marks1);
        System.out.println(Arrays.toString(marks1) + " swaps = " + swaps1);

        int[] marks2 = {80, 70, 60};
        int swaps2 = prizeTable(marks2);
        System.out.println(Arrays.toString(marks2) + " swaps = " + swaps2);

        System.out.println("\nProblem 3: The Library Book Shelf");
        int[] books = {30, 10, 40, 20};
        shelf(books);

        System.out.println("\nProblem 4: Is the Queue in Order?");
        int[] tokens1 = {3, 5, 5, 8, 6, 9};
        int[] tokens2 = {1, 2, 2, 7};
        System.out.println(firstBreak(tokens1));
        System.out.println(firstBreak(tokens2));

        System.out.println("\nProblem 5: The Dice Throw Tally");
        int[] rolls = {4, 1, 6, 4, 2, 1, 4};
        int[] sortedRolls = diceSort(rolls);
        System.out.println("Sorted: " + Arrays.toString(sortedRolls));
    }
}
