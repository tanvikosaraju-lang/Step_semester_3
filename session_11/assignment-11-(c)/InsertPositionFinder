public class InsertPositionFinder {
    public static int searchInsertPosition(int[] nums, int target) {
        int left = 0;
        int right = nums.length - 1;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            if (nums[mid] == target) {
                return mid;
            } else if (nums[mid] < target) {
                left = mid + 1;
            } else {
                right = mid - 1;
            }
        }

        return left;
    }

    public static void main(String[] args) {
        int[] nums1 = {1, 3, 5, 6};
        int target1 = 5;
        
        int[] nums2 = {1, 3, 5, 6};
        int target2 = 2;

        System.out.println(searchInsertPosition(nums1, target1));
        System.out.println(searchInsertPosition(nums2, target2));
    }
}
