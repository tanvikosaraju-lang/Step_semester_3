class WarehouseResult {
    int total;
    int maxRow;
    int maxCol;

    public WarehouseResult(int total, int maxRow, int maxCol) {
        this.total = total;
        this.maxRow = maxRow;
        this.maxCol = maxCol;
    }
}

public class WarehouseScanner {
    public static WarehouseResult warehouseSummary(int[][] grid) {
        int total = 0;
        int maxVal = Integer.MIN_VALUE;
        int maxRow = 0;
        int maxCol = 0;

        if (grid == null || grid.length == 0 || grid[0].length == 0) {
            return new WarehouseResult(0, -1, -1);
        }

        for (int i = 0; i < grid.length; i++) {
            for (int j = 0; j < grid[i].length; j++) {
                total += grid[i][j];
                if (grid[i][j] > maxVal) {
                    maxVal = grid[i][j];
                    maxRow = i;
                    maxCol = j;
                }
            }
        }

        return new WarehouseResult(total, maxRow, maxCol);
    }

    public static void main(String[] args) {
        int[][] grid = {
            {4, 9, 2},
            {7, 1, 6},
            {3, 12, 5}
        };

        WarehouseResult result = warehouseSummary(grid);
        System.out.println("total = " + result.total + ", maxCoordinate = (" + result.maxRow + ", " + result.maxCol + ")");
    }
}
