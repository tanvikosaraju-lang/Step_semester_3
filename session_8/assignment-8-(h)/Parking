import java.util.*;
import java.util.function.IntToDoubleFunction;
class Parking{
public static void main(String[]args){
Scanner sc=new Scanner(System.in);
int n=Integer.parseInt(sc.nextLine().trim());
Map<String,IntToDoubleFunction>rules=new HashMap<>();
rules.put("BIKE",hours->hours*10.0);
rules.put("CAR",hours->hours<=1?30.0:30.0+(hours-1)*20.0);
rules.put("TRUCK",hours->Math.max(hours*50.0,100.0));
double total=0;
StringBuilder sb=new StringBuilder();
for(int i=0;i<n;i++){
String[]parts=sc.nextLine().trim().split("\\s+");
String type=parts[0];
int hours=Integer.parseInt(parts[1]);
double charge=rules.get(type).applyAsDouble(hours);
total+=charge;
sb.append(type+": "+String.format("%.2f",charge)+"\n");
}
sb.append("Total: "+String.format("%.2f",total));
System.out.println();
System.out.println(sb.toString());
}
}
