import java.util.*;
import java.util.function.DoubleUnaryOperator;
class Festival{
public static void main(String[]args){
Scanner sc=new Scanner(System.in);
int n=Integer.parseInt(sc.nextLine().trim());
Map<String,DoubleUnaryOperator>rules=new HashMap<>();
rules.put("FULLTIME",salary->salary*0.10);
rules.put("PARTTIME",salary->salary*0.05);
rules.put("INTERN",salary->2000.0);
double total=0;
StringBuilder sb=new StringBuilder();
for(int i=0;i<n;i++){
String[]parts=sc.nextLine().trim().split("\\s+");
String type=parts[0];
String name=parts[1];
double salary=Double.parseDouble(parts[2]);
double bonus=rules.get(type).applyAsDouble(salary);
total+=bonus;
sb.append(name+": "+String.format("%.2f",bonus)+"\n");
}
sb.append("Total Bonus: "+String.format("%.2f",total));
System.out.println();
System.out.println(sb.toString());
}
}
