import java.util.*;
import java.util.function.DoubleUnaryOperator;
class Canteen{
public static void main(String[]args){
Scanner sc=new Scanner(System.in);
int n=Integer.parseInt(sc.nextLine().trim());
Map<String,DoubleUnaryOperator>rules=new HashMap<>();
rules.put("STUDENT",amt->amt*0.90);
rules.put("STAFF",amt->amt*0.95);
rules.put("GUEST",amt->amt+10);
double total=0;
StringBuilder sb=new StringBuilder();
for(int i=0;i<n;i++){
String[]parts=sc.nextLine().trim().split("\\s+");
String type=parts[0];
double amount=Double.parseDouble(parts[1]);
double finalAmt=rules.get(type).applyAsDouble(amount);
total+=finalAmt;
sb.append(type+": "+String.format("%.2f",finalAmt)+"\n");
}
sb.append("Total: "+String.format("%.2f",total));
System.out.println();
System.out.println(sb.toString());
}
}
