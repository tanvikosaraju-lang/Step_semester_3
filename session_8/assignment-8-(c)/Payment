import java.util.*;
abstract class PaymentMethod {
    protected double originalAmount;
    public PaymentMethod(double amount) {
        this.originalAmount = amount;
    }
    public abstract double calculateFinalAmount();
    public abstract String getPaymentTypeName();
}
class CardPayment extends PaymentMethod {
    public CardPayment(double amount) {
        super(amount);
    }
    public double calculateFinalAmount() {
        return originalAmount * 1.02;
    }
    public String getPaymentTypeName() {
        return "CARD";
    }
}
class WalletPayment extends PaymentMethod {
    public WalletPayment(double amount) {
        super(amount);
    }
    public double calculateFinalAmount() {
        return originalAmount * 1.01;
    }
    public String getPaymentTypeName() {
        return "WALLET";
    }
}
class BankTransferPayment extends PaymentMethod {
    public BankTransferPayment(double amount) {
        super(amount);
    }
    public double calculateFinalAmount() {
        return originalAmount;
    }
    public String getPaymentTypeName() {
        return "BANKTRANSFER";
    }
}
class Payment {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;
        int n = scanner.nextInt();
		System.out.println("---------------\n");
		System.out.println("PAYMENT INVOICE\n");
		System.out.println("---------------\n");
        List<PaymentMethod> transactions = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            String type = scanner.next();
            double amount = scanner.nextDouble();          
            if (type.equalsIgnoreCase("CARD")) {
                transactions.add(new CardPayment(amount));
            } 
			else if (type.equalsIgnoreCase("WALLET")) {
                transactions.add(new WalletPayment(amount));
            } 
			else if (type.equalsIgnoreCase("BANKTRANSFER")) {
                transactions.add(new BankTransferPayment(amount));
            }
        }
        double grandTotal = 0.0;
        for (PaymentMethod tx : transactions) {
            double adjustedAmount = tx.calculateFinalAmount();
            grandTotal += adjustedAmount;
            System.out.printf("%s: %.2f\n", tx.getPaymentTypeName(), adjustedAmount);
        }
        System.out.printf("Total: %.2f\n", grandTotal);
        scanner.close();
    }
}
