util.*;
class BMI 
{
public static String getBmiStatus(double bmi) 
{
if (bmi < 18.5) 
{
return "Underweight";
} 
else if (bmi < 25.0) 
{
return "Normal";
} 
else if (bmi < 30.0) 
{
return "Overweight";
} 
else 
{
return "Obese";
}
}
public static double calculateBmi(double heightM, double weightKg) 
{
return weightKg / (heightM * heightM);
}
public static void printWellnessReport(double[] heights, double[] weights) 
{
System.out.println("CORPORATE WELLNESS REPORT\n");
System.out.printf("%-10s %-14s %-14s %-8s %-14s%n", "Person", "Height (m)", "Weight (kg)", "BMI", "Status");
int underweight = 0, normal = 0, overweight = 0, obese = 0;
for (int i = 0; i < heights.length; i++) 
{
double bmi = calculateBmi(heights[i], weights[i]);
String status = getBmiStatus(bmi);
System.out.printf("%-10s %-14.2f %-14.2f %-8.2f %-14s%n", "Person " + (i + 1), heights[i], weights[i], bmi, status);
switch (status) 
{
case "Underweight": underweight++; break;
case "Normal": normal++; break;
case "Overweight": overweight++; break;
case "Obese": obese++; break;
}
}
System.out.println("Summary: Underweight: " + underweight+ " | Normal: " + normal+ " | Overweight: " + overweight+ " | Obese: " + obese);
}
public static void main(String[] args) 
{
int teamSize = 10;
boolean useRandomDemo = true;
double[] heights = new double[teamSize];
double[] weights = new double[teamSize];
if (useRandomDemo) 
{
Random rng = new Random();
for (int i = 0; i < teamSize; i++) 
{
heights[i] = round(1.50 + rng.nextDouble() * 0.50, 2);
weights[i] = round(45 + rng.nextDouble() * 65, 1);
}
} 
else 
{
double[] fixedHeights = {1.75, 1.60, 1.68, 1.82, 1.55, 1.70, 1.90, 1.65, 1.78, 1.60};
double[] fixedWeights = {70, 90, 55, 85, 48, 72, 95, 60, 68, 100};
heights = fixedHeights;
weights = fixedWeights;
}
printWellnessReport(heights, weights);
}
public static double round(double value, int places) 
{
double factor = Math.pow(10, places);
return Math.round(value * factor) / factor;
}
}
