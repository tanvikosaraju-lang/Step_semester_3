class LibraryIsbnValidator 
{
String normalizeCode(String raw) 
{
String trimmed = raw.trim();
if (trimmed.length() <= 3) 
{
return trimmed.toUpperCase();
}
String publisherCodePart = trimmed.substring(0, 3).toUpperCase();
String remainingPart = trimmed.substring(3);
return publisherCodePart + remainingPart;
}
String validateAndFormat(String code) 
{
String normalized = normalizeCode(code);
if (normalized.length() != 13) 
{
return "Invalid: code must be exactly 13 characters";
}
String publisherCode = normalized.substring(0, 3);
String yearPart = normalized.substring(3, 7);
String catalogPart = normalized.substring(7, 13);
for (int i = 0; i < publisherCode.length(); i++) 
{
if (!Character.isLetter(publisherCode.charAt(i))) 
{
return "Invalid: publisher code must be 3 letters";
}
}
String body = yearPart + catalogPart;
for (int i = 0; i < body.length(); i++) 
{
if (!Character.isDigit(body.charAt(i))) 
{
return "Invalid: code body must be 10 digits";
}
}
StringBuilder display = new StringBuilder();
display.append("[").append(publisherCode).append("] ");
display.append("YEAR: ").append(yearPart);
display.append(" | CATALOG: ").append(catalogPart);
return display.toString();
}
public static void main(String[] args) 
{
LibraryIsbnValidator validator = new LibraryIsbnValidator();
System.out.println(validator.validateAndFormat(" pen2026004251 "));
System.out.println(validator.validateAndFormat("12N2026004251"));
}
}
