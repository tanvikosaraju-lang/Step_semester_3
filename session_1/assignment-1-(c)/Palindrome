import java.util.*;
class Palindrome 
{
public static boolean isPalindromeIterative(String text) 
{
String s = normalize(text);
int left = 0, right = s.length() - 1;
while (left < right) 
{
if (s.charAt(left) != s.charAt(right)) 
{
 return false;
}
left++;
right--;
}
return true;
}
public static boolean isPalindromeRecursive(String text) 
{
String s = normalize(text);
return recursiveHelper(s, 0, s.length() - 1);
}
private static boolean recursiveHelper(String s, int left, int right) 
{ 
if (left >= right) 
{
return true;
}
if (s.charAt(left) != s.charAt(right)) 
{
return false;
}
return recursiveHelper(s, left + 1, right - 1);
}
public static boolean isPalindromeArrayReversal(String text) 
{
String s = normalize(text);
char[] original = s.toCharArray();
char[] reversed = new char[original.length];
for (int i = 0; i < original.length; i++) 
{
reversed[i] = original[original.length - 1 - i];
}
return Arrays.equals(original, reversed);
}
public static String normalize(String text) 
{
return text.toLowerCase().replaceAll("[^a-z0-9]", "");
}

public static void verify(String text) 
{
boolean iterative = isPalindromeIterative(text);
boolean recursive = isPalindromeRecursive(text);
boolean arrayReversal = isPalindromeArrayReversal(text);
String iterResult = iterative ? "Palindrome" : "Not Palindrome";
String recResult = recursive ? "Palindrome" : "Not Palindrome";
String arrResult = arrayReversal ? "Palindrome" : "Not Palindrome";
System.out.println("Input: \"" + text + "\"");
System.out.println("Iterative: " + iterResult + " | Recursive: " + recResult + " | Array Reversal: " + arrResult);
if (iterative == recursive && recursive == arrayReversal) 
{
System.out.println("All three approaches agree.\n");
} 
else 
{
System.out.println("MISMATCH DETECTED — logic needs review!\n");
}
} 
public static void main(String[] args) 
{
String[] testCases = {"madam", "hello", "racecar", "Java", "A man a plan a canal Panama", "", "a"};
for (String test : testCases) 
{
verify(test);
}
Scanner s = new Scanner(System.in);
System.out.print("Enter text to verify (or press Enter to skip): ");
String userInput = s.nextLine();
if (!userInput.isEmpty()) 
{
verify(userInput);
}
s.close();
}
}
