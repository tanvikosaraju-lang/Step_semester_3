import java.util.*;
class DuplicateTeam
{
static String findDuplicateTeam(String[] teamNames)
{
for (int i=0; i<teamNames.length; i++)
{
for (int j=i+1; j<teamNames.length; j++)
{
if (teamNames[i].equals(teamNames[j]))
{
return "Duplicate: " +teamNames[i];
}
}
}
return "No duplicate teams";
}
public static void main(String[] args)
{
System.out.println("DUPLICATE TEAM FINDER\n");
String[] t1 = {"ByteForce", "CodeCrafters", "ByteForce"};
System.out.println("The teams are: " +Arrays.toString(t1));
System.out.println(findDuplicateTeam(t1));
System.out.println();
String[] t2 = {"ByteForce", "CodeCrafters", "NullPointers"};
System.out.println("The teams are: " +Arrays.toString(t2));
System.out.println(findDuplicateTeam(t2));
}
}
